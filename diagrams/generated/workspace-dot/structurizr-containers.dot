digraph {
  compound=true
  graph [fontname="Arial", rankdir=LR, ranksep=1.0, nodesep=1.0]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">Container View - Platform-Standard Customer Recruitment Portal</font>>

  1 [id=1,shape=rect, label=<<font point-size="34">Customer Recruiter</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Customer user who reviews<br />assigned Jobstream candidates,<br />confirms the candidate-data<br />transfer, downloads the<br />customer copy, contacts<br />candidates, records outcomes,<br />and progresses the<br />customer-side workflow.</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
  2 [id=2,shape=rect, label=<<font point-size="34">Customer Recruitment<br />Manager</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Customer user who reviews<br />candidate progress within an<br />authorized customer scope.</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
  3 [id=3,shape=rect, label=<<font point-size="34">Jobstream Operations<br />User</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Jobstream user who monitors<br />customer follow-up, reviews<br />activity history, and supports<br />stalled candidate progress.</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
  5 [id=5,shape=rect, label=<<font point-size="34">Privacy/Security<br />Owner</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Approves confirmation wording,<br />pre-confirmation visibility,<br />minimized evidence, retention,<br />access, audit, and<br />authentication rules before<br />production release.</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
  6 [id=6,shape=rect, label=<<font point-size="34">HubSpot CRM</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Current source for candidate,<br />vacancy, customer, and<br />association data. TODO:<br />confirm whether HubSpot<br />remains system of record for<br />customer-stage and activity<br />data.</font>>, style=filled, color="#6b6b6b", fillcolor="#999999", fontcolor="#ffffff"]
  7 [id=7,shape=rect, label=<<font point-size="34">TODO: Identity<br />Provider</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Authenticates assigned<br />customer and Jobstream users.<br />TODO: select identity<br />provider, MFA, account<br />recovery, and session policy.</font>>, style=filled, color="#6b6b6b", fillcolor="#999999", fontcolor="#ffffff"]
  8 [id=8,shape=rect, label=<<font point-size="34">User Email Client</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External mail client opened<br />through mailto links; the<br />portal cannot prove message<br />delivery from this action.</font>>, style=filled, color="#6b6b6b", fillcolor="#999999", fontcolor="#ffffff"]
  9 [id=9,shape=rect, label=<<font point-size="34">WhatsApp</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External WhatsApp application<br />or web endpoint opened through<br />supported phone links; first<br />release does not verify<br />message delivery.</font>>, style=filled, color="#6b6b6b", fillcolor="#999999", fontcolor="#ffffff"]
  10 [id=10,shape=rect, label=<<font point-size="34">TODO: Notification<br />Channels</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">External channels used by the<br />Notification Framework for<br />reminders and access messages.<br />TODO: approve channels and<br />cadence.</font>>, style=filled, color="#6b6b6b", fillcolor="#999999", fontcolor="#ffffff"]
  11 [id=11,shape=rect, label=<<font point-size="34">TODO: Email Delivery<br />Provider</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Submits fixed, versioned<br />first-interview confirmation<br />emails from<br />no-reply@jobstream.nl. TODO:<br />select provider and approve<br />SPF, DKIM, DMARC, webhook, and<br />operational controls.</font>>, style=filled, color="#6b6b6b", fillcolor="#999999", fontcolor="#ffffff"]

  subgraph cluster_12 {
    margin=25
    label=<<font point-size="24"><br />Customer Recruitment Portal</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    13 [id=13,shape=rect, label=<<font point-size="34">Portal Web<br />Application</font><br /><font point-size="19">[Container: TODO: Web application technology]</font><br /><br /><font point-size="24">Dutch/English UI for candidate<br />queue, kanban/list views,<br />candidate detail, transfer<br />confirmation, export download,<br />contact shortcuts, logging,<br />stage updates, fixed<br />interview-email<br />preview/results, guidance, and<br />oversight.</font>>, style=filled, color="#2e6295", fillcolor="#438dd5", fontcolor="#ffffff"]
    14 [id=14,shape=rect, label=<<font point-size="34">Business Object API</font><br /><font point-size="19">[Container: TODO: API service technology]</font><br /><br /><font point-size="24">Exposes standard object APIs<br />plus idempotent<br />transfer-confirmation,<br />lifecycle-transition,<br />interview-email<br />preview/request, and<br />email-retry commands; enforces<br />permission checks consistently<br />for UI, workflows, and<br />integrations.</font>>, style=filled, color="#2e6295", fillcolor="#438dd5", fontcolor="#ffffff"]
    15 [id=15,shape=rect, label=<<font point-size="34">Customer Recruitment<br />Business Module</font><br /><font point-size="19">[Container: TODO: Application module]</font><br /><br /><font point-size="24">Defines customer recruitment<br />business objects, lifecycle<br />rules, transfer and export<br />rules, structured interview<br />appointments, activity types,<br />permissions, retention<br />workflows, and notification<br />requests without<br />reimplementing platform<br />services.</font>>, style=filled, color="#5d82a8", fillcolor="#85bbf0", fontcolor="#000000"]
    16 [id=16,shape=rect, label=<<font point-size="34">Platform Services</font><br /><font point-size="19">[Container: TODO: Shared platform runtime]</font><br /><br /><font point-size="24">Reusable Object Framework,<br />State Engine, Timeline Engine,<br />Activity Framework, Permission<br />Framework, Workflow Engine,<br />Notification Framework,<br />Template Engine, Audit<br />Framework, Search Framework,<br />and File Framework.</font>>, style=filled, color="#074a38", fillcolor="#0b6b50", fontcolor="#ffffff"]
    17 [id=17,shape=rect, label=<<font point-size="34">Workflow And<br />Notification Worker</font><br /><font point-size="19">[Container: TODO: Worker service technology]</font><br /><br /><font point-size="24">Consumes domain events,<br />executes 90-day retention<br />disposal across portal stores,<br />evaluates follow-up workflows,<br />submits durable<br />interview-email requests and<br />reminders, and records<br />timeline activities.</font>>, style=filled, color="#2e6295", fillcolor="#438dd5", fontcolor="#ffffff"]
    18 [id=18,shape=rect, label=<<font point-size="34">HubSpot<br />Synchronization<br />Adapter</font><br /><font point-size="19">[Container: TODO: Integration service technology]</font><br /><br /><font point-size="24">Maps HubSpot candidate,<br />vacancy, company, and<br />association data into portal<br />business objects and<br />synchronizes approved updates<br />where the architecture<br />decision allows it.</font>>, style=filled, color="#2e6295", fillcolor="#438dd5", fontcolor="#ffffff"]
    19 [id=19,shape=cylinder, label=<<font point-size="34">Business Application<br />Data Store</font><br /><font point-size="19">[Container: PostgreSQL]</font><br /><br /><font point-size="24">Stores business objects,<br />lifecycle state, interview<br />appointments, notification<br />templates/requests/attempts,<br />transfer confirmations,<br />minimized evidence, retention<br />state, timelines, activities,<br />permissions, and audit<br />metadata.</font>>, style=filled, color="#206895", fillcolor="#2f95d6", fontcolor="#ffffff"]
    20 [id=20,shape=rect, label=<<font point-size="34">Domain Event Bus</font><br /><font point-size="19">[Container: TODO: Event bus technology]</font><br /><br /><font point-size="24">Publishes meaningful business<br />changes for workflows,<br />notifications, integrations,<br />analytics, and audit<br />consumers.</font>>, style=filled, color="#ab7418", fillcolor="#f5a623", fontcolor="#000000"]
    21 [id=21,shape=cylinder, label=<<font point-size="34">Search Index</font><br /><font point-size="19">[Container: PostgreSQL full-text search and indexes]</font><br /><br /><font point-size="24">Supports authorized candidate<br />queue, kanban, and oversight<br />search and removes<br />transfer-context candidate<br />content at the 90-day expiry.</font>>, style=filled, color="#206895", fillcolor="#2f95d6", fontcolor="#ffffff"]
    22 [id=22,shape=folder, label=<<font point-size="34">File Store</font><br /><font point-size="19">[Container: TODO: File storage technology]</font><br /><br /><font point-size="24">Stores or references approved<br />CV/source documents and<br />version-bound customer export<br />packages; portal-owned<br />transfer copies expire after<br />90 days. TODO: confirm<br />source-document storage<br />boundary.</font>>, style=filled, color="#206895", fillcolor="#2f95d6", fontcolor="#ffffff"]
  }

  1 -> 13 [id=23, label=<<font point-size="24">Reviews assigned<br />candidates, confirms data<br />transfer, downloads the<br />customer copy, uses<br />contact shortcuts, logs<br />outcomes, changes stages,<br />and previews/confirms<br />first-interview emails</font><br /><font point-size="19">[HTTPS]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  2 -> 13 [id=25, label=<<font point-size="24">Reviews candidates and<br />follow-up progress in an<br />authorized customer scope</font><br /><font point-size="19">[HTTPS]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  3 -> 13 [id=27, label=<<font point-size="24">Reviews oversight views,<br />activity history, stalled<br />candidates, and customer<br />follow-up evidence</font><br /><font point-size="19">[HTTPS]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  5 -> 13 [id=29, label=<<font point-size="24">Reviews configured<br />privacy/audit behavior<br />where administrative<br />review screens exist</font><br /><font point-size="19">[HTTPS/TODO]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  3 -> 6 [id=33, label=<<font point-size="24">Maintains source<br />candidate, vacancy,<br />customer, and association<br />data where HubSpot remains<br />the operational CRM</font><br /><font point-size="19">[HubSpot UI]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  13 -> 7 [id=34, label=<<font point-size="24">Authenticates assigned<br />users and receives<br />identity/session claims</font><br /><font point-size="19">[OIDC/SAML/TODO]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  13 -> 14 [id=36, label=<<font point-size="24">Reads objects and submits<br />transfer-confirmation,<br />export-download,<br />transition, and activity<br />commands</font><br /><font point-size="19">[JSON/HTTPS]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  13 -> 8 [id=37, label=<<font point-size="24">Opens mailto contact<br />shortcut after transfer<br />confirmation</font><br /><font point-size="19">[mailto]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  13 -> 9 [id=39, label=<<font point-size="24">Opens WhatsApp contact<br />shortcut after transfer<br />confirmation</font><br /><font point-size="19">[HTTPS/deep link]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  14 -> 15 [id=41, label=<<font point-size="24">Delegates customer<br />recruitment rules, object<br />definitions, validation,<br />and transition commands</font><br /><font point-size="19">[In-process call (ASSUMPTION)]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  14 -> 16 [id=42, label=<<font point-size="24">Uses object, state,<br />timeline, activity,<br />permission, audit, search,<br />and file services</font><br /><font point-size="19">[Internal API]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  15 -> 16 [id=43, label=<<font point-size="24">Configures and invokes<br />shared platform<br />capabilities instead of<br />implementing its own<br />infrastructure</font><br /><font point-size="19">[Internal API]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  16 -> 19 [id=44, label=<<font point-size="24">Persists objects, state,<br />timeline, activities,<br />permissions, and audit<br />metadata</font><br /><font point-size="19">[SQL]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  16 -> 20 [id=45, label=<<font point-size="24">Publishes domain events<br />for meaningful business<br />changes</font><br /><font point-size="19">[TODO]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  16 -> 21 [id=46, label=<<font point-size="24">Indexes authorized object<br />and timeline data for<br />queue and oversight views</font><br /><font point-size="19">[SQL]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  16 -> 22 [id=47, label=<<font point-size="24">Stores or retrieves<br />CV/source documents and<br />version-bound customer<br />export packages through<br />the File Framework</font><br /><font point-size="19">[TODO]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  17 -> 20 [id=48, label=<<font point-size="24">Consumes domain events<br />such as CandidateSupplied,<br />TransferConfirmed,<br />TransferRetentionExpired,<br />StageChanged,<br />CandidateEmailRequested,<br />CandidateEmailRetryRequested,<br />FollowUpOverdue, and<br />CandidateRejected</font><br /><font point-size="19">[TODO]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  17 -> 16 [id=49, label=<<font point-size="24">Executes configured<br />workflows, disposes<br />expired<br />database/file/search<br />copies, creates<br />activities, requests<br />notifications, and records<br />disposal evidence</font><br /><font point-size="19">[Internal API]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  17 -> 10 [id=50, label=<<font point-size="24">Delivers reminders and<br />workflow notifications<br />through approved channels</font><br /><font point-size="19">[TODO]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  17 -> 11 [id=52, label=<<font point-size="24">Submits fixed, versioned<br />first-interview emails and<br />records provider<br />acceptance or failure</font><br /><font point-size="19">[HTTPS/TODO]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  18 -> 6 [id=54, label=<<font point-size="24">Reads and writes approved<br />CRM data and associations</font><br /><font point-size="19">[HubSpot API]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  18 -> 16 [id=56, label=<<font point-size="24">Creates or updates mapped<br />business objects,<br />relationships, activities,<br />and timeline entries</font><br /><font point-size="19">[Internal API]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  18 -> 20 [id=57, label=<<font point-size="24">Publishes synchronization<br />and integration events</font><br /><font point-size="19">[TODO]</font>>, style="dashed", color="#444444", fontcolor="#444444"]

