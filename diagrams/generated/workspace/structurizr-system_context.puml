@startuml
title <size:24>System Context - Customer Recruitment Portal</size>

set separator none
left to right direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,External System
  .Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0= {
    BackgroundColor: #999999;
    LineColor: #6b6b6b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,System Of Interest
  .Element-RWxlbWVudCxTeXN0ZW0gT2YgSW50ZXJlc3Q= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
</style>

person "==Customer Recruiter\n<size:16>[Person]</size>\n\nCustomer user who reviews assigned Jobstream candidates, confirms the candidate-data transfer, downloads the customer copy, contacts candidates, records outcomes, and progresses the customer-side workflow." <<Element-RWxlbWVudCxQZXJzb24=>> as CustomerRecruiter
rectangle "==TODO: Notification Channels\n<size:16>[Software System]</size>\n\nExternal channels used by the Notification Framework for reminders and access messages. TODO: approve channels and cadence." <<Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0=>> as TODONotificationChannels
rectangle "==Customer Recruitment Portal\n<size:16>[Software System]</size>\n\nBusiness application that lets authorized customer users review Jobstream candidates, confirm data transfer, obtain a customer copy, and perform contact, follow-up, stage progression, notes, and oversight." <<Element-RWxlbWVudCxTeXN0ZW0gT2YgSW50ZXJlc3Q=>> as CustomerRecruitmentPortal
person "==Customer Recruitment Manager\n<size:16>[Person]</size>\n\nCustomer user who reviews candidate progress within an authorized customer scope." <<Element-RWxlbWVudCxQZXJzb24=>> as CustomerRecruitmentManager
person "==Jobstream Operations User\n<size:16>[Person]</size>\n\nJobstream user who monitors customer follow-up, reviews activity history, and supports stalled candidate progress." <<Element-RWxlbWVudCxQZXJzb24=>> as JobstreamOperationsUser
person "==Candidate\n<size:16>[Person]</size>\n\nData subject represented in the recruitment workflow; not a direct portal user in the first release." <<Element-RWxlbWVudCxQZXJzb24=>> as Candidate
person "==Privacy/Security Owner\n<size:16>[Person]</size>\n\nApproves confirmation wording, pre-confirmation visibility, minimized evidence, retention, access, audit, and authentication rules before production release." <<Element-RWxlbWVudCxQZXJzb24=>> as PrivacySecurityOwner
rectangle "==HubSpot CRM\n<size:16>[Software System]</size>\n\nCurrent source for candidate, vacancy, customer, and association data. TODO: confirm whether HubSpot remains system of record for customer-stage and activity data." <<Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0=>> as HubSpotCRM
rectangle "==TODO: Identity Provider\n<size:16>[Software System]</size>\n\nAuthenticates assigned customer and Jobstream users. TODO: select identity provider, MFA, account recovery, and session policy." <<Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0=>> as TODOIdentityProvider
rectangle "==User Email Client\n<size:16>[Software System]</size>\n\nExternal mail client opened through mailto links; the portal cannot prove message delivery from this action." <<Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0=>> as UserEmailClient
rectangle "==WhatsApp\n<size:16>[Software System]</size>\n\nExternal WhatsApp application or web endpoint opened through supported phone links; first release does not verify message delivery." <<Element-RWxlbWVudCxFeHRlcm5hbCBTeXN0ZW0=>> as WhatsApp

CustomerRecruiter --> CustomerRecruitmentPortal <<Relationship-UmVsYXRpb25zaGlw>> : "Reviews assigned candidates, confirms data transfer, downloads the customer copy, uses contact shortcuts, logs outcomes, and changes stages\n<size:16>[HTTPS]</size>"
CustomerRecruitmentManager --> CustomerRecruitmentPortal <<Relationship-UmVsYXRpb25zaGlw>> : "Reviews candidates and follow-up progress in an authorized customer scope\n<size:16>[HTTPS]</size>"
JobstreamOperationsUser --> CustomerRecruitmentPortal <<Relationship-UmVsYXRpb25zaGlw>> : "Reviews oversight views, activity history, stalled candidates, and customer follow-up evidence\n<size:16>[HTTPS]</size>"
PrivacySecurityOwner --> CustomerRecruitmentPortal <<Relationship-UmVsYXRpb25zaGlw>> : "Reviews configured privacy/audit behavior where administrative review screens exist\n<size:16>[HTTPS/TODO]</size>"
Candidate --> HubSpotCRM <<Relationship-UmVsYXRpb25zaGlw>> : "Provides source candidate information through the existing Jobstream recruitment process\n<size:16>[Existing process]</size>"
JobstreamOperationsUser --> HubSpotCRM <<Relationship-UmVsYXRpb25zaGlw>> : "Maintains source candidate, vacancy, customer, and association data where HubSpot remains the operational CRM\n<size:16>[HubSpot UI]</size>"
CustomerRecruitmentPortal --> TODOIdentityProvider <<Relationship-UmVsYXRpb25zaGlw>> : "Authenticates assigned users and receives identity/session claims\n<size:16>[OIDC/SAML/TODO]</size>"
CustomerRecruitmentPortal --> UserEmailClient <<Relationship-UmVsYXRpb25zaGlw>> : "Opens mailto contact shortcut after transfer confirmation\n<size:16>[mailto]</size>"
CustomerRecruitmentPortal --> WhatsApp <<Relationship-UmVsYXRpb25zaGlw>> : "Opens WhatsApp contact shortcut after transfer confirmation\n<size:16>[HTTPS/deep link]</size>"
CustomerRecruitmentPortal --> TODONotificationChannels <<Relationship-UmVsYXRpb25zaGlw>> : "Delivers reminders and workflow notifications through approved channels\n<size:16>[TODO]</size>"
CustomerRecruitmentPortal --> HubSpotCRM <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and writes approved CRM data and associations\n<size:16>[HubSpot API]</size>"

@enduml