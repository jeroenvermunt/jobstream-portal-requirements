@startuml
title <size:24>Container View – Recruitment Marketing Platform (HubSpot-centric)</size>

set separator none
left to right direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,ExternalSystem
  .Element-RWxlbWVudCxFeHRlcm5hbFN5c3RlbQ== {
    BackgroundColor: #999999;
    LineColor: #6b6b6b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
  // Recruitment Marketing Platform
  .Boundary-UmVjcnVpdG1lbnQgTWFya2V0aW5nIFBsYXRmb3Jt {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Recruitment Marketer\n<size:16>[Person]</size>\n\nManages job vacancies, deals and recruitment campaigns in HubSpot." <<Element-RWxlbWVudCxQZXJzb24=>> as RecruitmentMarketer
person "==Selection Agent\n<size:16>[Person]</size>\n\nCalls candidates and maintains candidate statuses in HubSpot." <<Element-RWxlbWVudCxQZXJzb24=>> as SelectionAgent
person "==Customer User\n<size:16>[Person]</size>\n\nReviews and approves candidates via the customer portal." <<Element-RWxlbWVudCxQZXJzb24=>> as CustomerUser
person "==Candidate\n<size:16>[Person]</size>\n\nSubmits personal details via a Meta lead form." <<Element-RWxlbWVudCxQZXJzb24=>> as Candidate
rectangle "==Meta Ads (Facebook Lead Forms)\n<size:16>[Software System]</size>\n\nProvides lead form submissions from advertising campaigns." <<Element-RWxlbWVudCxFeHRlcm5hbFN5c3RlbQ==>> as MetaAdsFacebookLeadForms

rectangle "Recruitment Marketing Platform\n<size:16>[Software System]</size>" <<Boundary-UmVjcnVpdG1lbnQgTWFya2V0aW5nIFBsYXRmb3Jt>> {
  rectangle "==Lead Intake Integration\n<size:16>[Container: HubSpot workflow]</size>\n\nReceives Meta lead events and creates or updates Candidate records in HubSpot. TODO: native vs custom implementation." <<Element-RWxlbWVudCxDb250YWluZXI=>> as RecruitmentMarketingPlatform.LeadIntakeIntegration
  rectangle "==HubSpot CRM Data Model\n<size:16>[Container: HubSpot CRM]</size>\n\nStandard and custom objects: Deal, Company, Job Vacancy and Candidate, including relationships." <<Element-RWxlbWVudCxDb250YWluZXI=>> as RecruitmentMarketingPlatform.HubSpotCRMDataModel
  rectangle "==Customer Portal (HubSpot CMS Module)\n<size:16>[Container: HubSpot CMS]</size>\n\nDisplays candidate data based on lead pipeline status, linked company and vacancy objects. Support candidate approval." <<Element-RWxlbWVudCxDb250YWluZXI=>> as RecruitmentMarketingPlatform.CustomerPortalHubSpotCMSModule
}

Candidate --> MetaAdsFacebookLeadForms <<Relationship-UmVsYXRpb25zaGlw>> : "Submits lead form"
RecruitmentMarketingPlatform.LeadIntakeIntegration --> MetaAdsFacebookLeadForms <<Relationship-UmVsYXRpb25zaGlw>> : "Receives lead submissions\n<size:16>[Webhook/HTTPS]</size>"
RecruitmentMarketingPlatform.LeadIntakeIntegration --> RecruitmentMarketingPlatform.HubSpotCRMDataModel <<Relationship-UmVsYXRpb25zaGlw>> : "Creates/updates Candidate records\n<size:16>[HubSpot API (assumption)]</size>"
RecruitmentMarketingPlatform.CustomerPortalHubSpotCMSModule --> RecruitmentMarketingPlatform.HubSpotCRMDataModel <<Relationship-UmVsYXRpb25zaGlw>> : "Reads candidate data via lead-company relationship\n<size:16>[HubSpot internal]</size>"
CustomerUser --> RecruitmentMarketingPlatform.CustomerPortalHubSpotCMSModule <<Relationship-UmVsYXRpb25zaGlw>> : "Approves or rejects candidate\n<size:16>[HTTPS]</size>"
RecruitmentMarketer --> RecruitmentMarketingPlatform.HubSpotCRMDataModel <<Relationship-UmVsYXRpb25zaGlw>> : "Maintains Job Vacancies, Deals and relationships\n<size:16>[HubSpot UI]</size>"
SelectionAgent --> RecruitmentMarketingPlatform.HubSpotCRMDataModel <<Relationship-UmVsYXRpb25zaGlw>> : "Updates Candidate status\n<size:16>[HubSpot UI]</size>"

@enduml